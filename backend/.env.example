# Copy to .env and fill in real values. NEVER commit .env.

# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service-role key — server only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Pepper for hashing panel verification codes (any long random string).
# Changing it invalidates existing codes (they must be rotated).
CODE_PEPPER=change-me-to-a-long-random-string

# Optional overrides
# PORT=4000
# CORS_ORIGIN=https://your-frontend.vercel.app
# VERIFY_ATTEMPT_LOCKOUT_MINUTES=10
# OFFLINE_SESSION_HOURS=12
