# Copy to .env and fill in values from Supabase (Settings → API).
# These are publishable client values — never put the service-role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Backend API base URL. Leave empty in dev (Vite proxies /api to localhost:4000).
# Production example: VITE_API_URL=https://your-backend.vercel.app
VITE_API_URL=

# Hours a logged-in judge may keep using the app offline without re-authenticating.
VITE_OFFLINE_SESSION_HOURS=12
